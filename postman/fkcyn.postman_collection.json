{
  "info": { "name": "fkcyn · Rain sensor API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Use test-01 with TEST_DEVICE_TOKEN. Every NEW report gets a new eventId; retry with the same id/body for idempotency. Read tokens are separate from device tokens." },
  "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.variables.set('eventId', pm.variables.replaceIn('{{$guid}}'));", "pm.variables.set('observedAt', new Date().toISOString());", "const today = new Intl.DateTimeFormat('en-CA', {timeZone:'Asia/Bangkok',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());", "if (!pm.environment.get('from')) pm.variables.set('from', today);", "if (!pm.environment.get('to')) pm.variables.set('to', today);"] } }],
  "item": [
    { "name": "Report wet", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{deviceToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/readings", "body": { "mode": "raw", "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"deviceId\": \"test-01\",\n  \"sensorType\": \"rain\",\n  \"wet\": true,\n  \"observedAt\": \"{{observedAt}}\"\n}", "options": { "raw": { "language": "json" } } } }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Saved', () => pm.response.to.have.status(201));", "pm.test('Test source only', () => pm.expect(pm.response.json().source).to.eql('test'));"], "type": "text/javascript" } }] },
    { "name": "Report dry (optional stop event)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{deviceToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/readings", "body": { "mode": "raw", "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"deviceId\": \"test-01\",\n  \"sensorType\": \"rain\",\n  \"wet\": false,\n  \"observedAt\": \"{{observedAt}}\"\n}", "options": { "raw": { "language": "json" } } } } },
    { "name": "Read test history", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{dashboardToken}}" }], "url": "{{baseUrl}}/api/readings?from={{from}}&to={{to}}&source=test" } },
    { "name": "Weather · Bangkok (model data)", "request": { "method": "GET", "url": "{{baseUrl}}/api/weather?lat=13.75&lon=100.5" } },
    { "name": "Configuration status", "request": { "method": "GET", "url": "{{baseUrl}}/api/config" } }
  ]
}
