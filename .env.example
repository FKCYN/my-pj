# Copy to .env.local. Never commit your secrets.
# Development-only JSON store. Ignored in production / Vercel.
LOCAL_STORE=true
# Generate different long random tokens for the two registered devices.
TEST_DEVICE_TOKEN=
ROOM_DEVICE_TOKEN=
# Optional separate token for reading the API in Postman (not a write token).
DASHBOARD_API_TOKEN=

# Add these together when ready to use Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# The Auth user UUID allowed to open this personal dashboard.
DASHBOARD_USER_ID=
